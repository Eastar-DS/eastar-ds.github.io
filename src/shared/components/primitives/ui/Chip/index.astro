---
interface Props {
  /** 있으면 링크로 그립니다 */
  href?: string;
  /** 이름 옆에 옅게 보이는 보조 문구. 예: `3편` */
  count?: string;
}

/** 둥근 알약 모양의 작은 이름표입니다 */
const { href, count } = Astro.props;
const Tag = href ? "a" : "span";
---

<Tag class="container" href={href}>
  <span class="label"><slot /></span>
  {count && <span class="count">{count}</span>}
</Tag>

<style>
  .container {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    padding: 5px 12px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    color: var(--color-text);
    font-size: var(--font-size-small);
    line-height: 1.5;
    transition:
      border-color 0.15s,
      color 0.15s;
  }

  a.container:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .count {
    color: var(--color-text-muted);
    font-size: 12px;
  }
</style>
