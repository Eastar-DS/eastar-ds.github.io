---
interface Props {
  /**
   * 그릴 요소
   * - `button`: 누르면 동작하는 단추 (기본)
   * - `a`: 다른 곳으로 가는 링크. `href`를 함께 넣습니다
   * - `summary`: `<details>`의 머리. 메뉴처럼 JavaScript 없이 펼치는 단추
   */
  as?: "button" | "a" | "summary";
  /** 스크린 리더가 읽는 이름. 아이콘만 있으므로 꼭 넣습니다 */
  label: string;
  href?: string;
  class?: string;
  [attribute: `data-${string}`]: string | boolean | undefined;
}

/**
 * 글자 없이 아이콘 하나만 있는 단추입니다. 넓은 화면 36px, 휴대폰 40px 칸 가운데에 18px 아이콘을 둡니다.
 * 아이콘은 기본 슬롯에 `Icon`으로 넣습니다.
 * @design design/blog.pen 「아이콘 단추」 Bh8HQ (기본 Owo4g · 올림 HkCTt · 포커스 wsfAi)
 */
const {
  as: Tag = "button",
  label,
  href,
  class: className,
  ...rest
} = Astro.props;

// Astro는 부모의 범위 속성(data-astro-cid-*)도 props로 넘깁니다. 그대로 펼치면 부모의 같은 이름 클래스(.root 등) 규칙이
// 이 단추에 걸리므로, data-theme-toggle 같은 우리 속성만 펼칩니다
const attributes = Object.fromEntries(
  Object.entries(rest).filter(([key]) => !key.startsWith("data-astro-cid")),
);
---

<Tag
  class:list={["root", className]}
  href={Tag === "a" ? href : undefined}
  type={Tag === "button" ? "button" : undefined}
  aria-label={label}
  {...attributes}
>
  <slot />
</Tag>

<style>
  .root {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: var(--icon-button-size);
    height: var(--icon-button-size);
    padding: 0;
    border: 0;
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
    list-style: none;
    transition:
      color var(--duration-fast) var(--ease-standard),
      background-color var(--duration-fast) var(--ease-standard);
  }

  .root::-webkit-details-marker {
    display: none;
  }

  .root:hover {
    background: var(--color-surface-hover);
    color: var(--color-text);
  }

  .root:focus-visible {
    border-radius: var(--radius-md);
  }
</style>
