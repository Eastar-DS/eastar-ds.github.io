---
interface Props {
  /**
   * - `wide`: 넓은 화면(1200px 이상)에서만 보입니다
   * - `narrow`: 그보다 좁은 화면에서만 보입니다
   */
  screen: "wide" | "narrow";
}

/**
 * 화면 폭에 따라 내용을 보이거나 숨깁니다. 숨긴 내용은 스크린 리더에도 읽히지 않습니다.
 * @design design/blog.pen 기초 보드 「04 화면 폭과 배치」 e2gfM
 */
const { screen } = Astro.props;
---

<div class={screen}>
  <slot />
</div>

<style>
  .wide {
    display: none;
  }

  @media (min-width: 1200px) {
    .wide {
      display: block;
    }

    .narrow {
      display: none;
    }
  }
</style>
