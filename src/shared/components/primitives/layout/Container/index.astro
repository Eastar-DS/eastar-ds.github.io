---
interface Props {
  /**
   * - `page`: 머리말 · 꼬리말처럼 화면 전체 폭을 쓰는 줄 (1200px)
   * - `content`: 글 목록처럼 본문 폭만 쓰는 칸 (680px)
   * - `withAside`: 본문과 옆 목차를 함께 담는 칸 (680 + 72 + 220 = 972px)
   */
  size?: "page" | "content" | "withAside";
  as?: "div" | "main" | "section";
}

/**
 * 내용을 가운데에 두고 최대 폭과 좌우 여백(휴대폰 20px, 768px부터 40px)을 정합니다.
 * @design design/blog.pen 기초 보드 「04 화면 폭과 배치」 e2gfM
 */
const { size = "page", as: Tag = "div" } = Astro.props;
---

<Tag class:list={["root", size]}>
  <slot />
</Tag>

<style>
  .root {
    width: 100%;
    margin-inline: auto;
    padding-inline: var(--page-padding-inline);
  }

  .page {
    max-width: calc(var(--page-max-width) + var(--page-padding-inline) * 2);
  }

  .content {
    max-width: calc(var(--content-width) + var(--page-padding-inline) * 2);
  }

  .withAside {
    max-width: calc(
      var(--content-width) + var(--layout-gap) + var(--toc-width) +
        var(--page-padding-inline) * 2
    );
  }
</style>
