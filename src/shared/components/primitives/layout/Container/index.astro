---
interface Props {
  /**
   * - `page`: 머리말 · 꼬리말처럼 화면 전체 폭을 쓰는 줄 (1200px)
   * - `content`: 글 목록처럼 본문 폭만 쓰는 칸 (680px)
   * - `withAside`: 본문과 옆 칸을 함께 담는 칸
   */
  size?: "page" | "content" | "withAside";
  as?: "div" | "main" | "section";
}

/** 내용을 가운데에 두고 최대 폭과 좌우 여백을 정합니다 */
const { size = "page", as: Tag = "div" } = Astro.props;
---

<Tag class:list={["root", size]}>
  <slot />
</Tag>

<style>
  .root {
    width: 100%;
    margin-inline: auto;
    padding-inline: var(--space-page-inline);
  }

  .page {
    max-width: calc(var(--width-page) + var(--space-page-inline) * 2);
  }

  .content {
    max-width: calc(var(--width-content) + var(--space-page-inline) * 2);
  }

  .withAside {
    max-width: calc(
      var(--width-content) + var(--width-aside) + 72px +
        var(--space-page-inline) * 2
    );
  }
</style>
