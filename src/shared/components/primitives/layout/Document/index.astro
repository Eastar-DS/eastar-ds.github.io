---
import "@/shared/styles/index.css";
// 사이트에 쓰인 글자만 담은 본문 글꼴(Pretendard 부분 글꼴). 가변 글꼴이라 쓰는 굵기가 모두 이 파일 하나에 있습니다.
// ?url로 불러오면 CSS의 @font-face가 부르는 것과 같은 빌드 주소(해시 포함)가 나와서 두 번 받지 않습니다 (docs/design-system.md 10장)
import sansFontUrl from "@/shared/styles/fonts/blog-sans.woff2?url";

import SkipLink from "@/shared/components/primitives/ui/SkipLink/index.astro";
import { MAIN_CONTENT_ID, PATHS } from "@/shared/routes/paths";
import { POSTHOG_PROJECT_KEY, WORKER_URL } from "@/shared/constants/services";
import { SITE } from "@/shared/constants/site";
import { THEME_STORAGE_KEY } from "@/shared/constants/theme";
import type { JsonLd, PageMeta } from "@/shared/types/seo";
import shouldLoadAnalytics from "@/shared/utils/shouldLoadAnalytics";

import AnalyticsScript from "./ui/AnalyticsScript.astro";

interface Props {
  /** `shared/seo/createPageMeta`로 만든 메타 정보 */
  meta: PageMeta;
  /** 페이지에 넣을 구조화 데이터 */
  jsonLds?: JsonLd[];
}

/**
 * HTML 문서의 뼈대(`<html lang="ko">`, `<head>` 메타, `<body>`)만 그립니다.
 * 머리말 · 꼬리말 같은 화면 구조는 담지 않습니다. 화면 배치는 페이지가 직접 정합니다.
 * `<body>` 맨 앞에 건너뛰기 링크를 두므로, 페이지는 `<main id={MAIN_CONTENT_ID} tabindex="-1">`을 하나 둡니다.
 * 공유 카드 메타(og, twitter)는 모든 페이지에 그림을 넣고 큰 그림 카드(`summary_large_image`)로 그립니다.
 * `rel="describedby"`는 이 사이트를 설명하는 llms.txt를 알립니다(https://llmstxt.org 의 v2 제안).
 * 방문 통계(PostHog)는 `WORKER_URL` · `POSTHOG_PROJECT_KEY`(shared/constants/services)가 모두 있을 때만 `<body>` 끝에서 늦게 불러옵니다.
 * 값이 비어 있으면 astro.config.ts가 AnalyticsScript를 빈 부품으로 바꿔 빌드 결과에 싣지 않습니다.
 *
 * - 기본 슬롯: `<body>` 안의 내용
 * - `head` 슬롯: 페이지마다 더할 `<head>` 요소
 */
const { meta, jsonLds = [] } = Astro.props;
const isAnalyticsEnabled = shouldLoadAnalytics({
  workerUrl: WORKER_URL,
  projectKey: POSTHOG_PROJECT_KEY,
});

// 인라인 스크립트가 하는 일
// 1. <html>의 no-js 클래스를 지웁니다. JavaScript가 꺼져 있을 때만 남아, 움직이지 않는 단추를 숨기는 데 씁니다.
// 2. 사용자가 고른 테마를 첫 그림 전에 적용해서 깜빡이지 않게 합니다.
//    고르지 않았으면 아무것도 하지 않고, CSS(color-scheme: light dark)가 시스템 설정을 따릅니다.

// JSON 안의 </script>가 스크립트를 끝내지 않게 < 를 바꿔 둡니다
const serializeJsonLd = (jsonLd: JsonLd) =>
  JSON.stringify(jsonLd).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="ko" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    {meta.canonicalUrl && <link rel="canonical" href={meta.canonicalUrl} />}
    <meta name="color-scheme" content="light dark" />
    <meta
      name="theme-color"
      content="#ffffff"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#0f1115"
      media="(prefers-color-scheme: dark)"
    />
    <link
      rel="preload"
      href={sansFontUrl}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={meta.siteName}
      href={PATHS.rss}
    />
    <link rel="sitemap" href={PATHS.sitemap} />
    <link rel="describedby" href={PATHS.llms} />
    <meta name="generator" content={Astro.generator} />
    {
      SITE.verification.google && (
        <meta name="google-site-verification" content={SITE.verification.google} />
      )
    }
    {
      SITE.verification.naver && (
        <meta name="naver-site-verification" content={SITE.verification.naver} />
      )
    }

    <meta property="og:type" content={meta.ogType} />
    <meta property="og:site_name" content={meta.siteName} />
    <meta property="og:locale" content={meta.locale} />
    <meta property="og:title" content={meta.ogTitle} />
    <meta property="og:description" content={meta.description} />
    {meta.canonicalUrl && <meta property="og:url" content={meta.canonicalUrl} />}
    <meta property="og:image" content={meta.image.url} />
    <meta property="og:image:type" content={meta.image.type} />
    <meta property="og:image:width" content={String(meta.image.width)} />
    <meta property="og:image:height" content={String(meta.image.height)} />
    <meta property="og:image:alt" content={meta.image.alt} />
    {
      meta.publishedTime && (
        <meta property="article:published_time" content={meta.publishedTime} />
      )
    }
    {
      meta.modifiedTime && (
        <meta property="article:modified_time" content={meta.modifiedTime} />
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.ogTitle} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content={meta.image.url} />
    <meta name="twitter:image:alt" content={meta.image.alt} />

    {
      jsonLds.map((jsonLd) => (
        <script type="application/ld+json" set:html={serializeJsonLd(jsonLd)} />
      ))
    }

    <script is:inline define:vars={{ storageKey: THEME_STORAGE_KEY }}>
      document.documentElement.classList.remove("no-js");
      try {
        const storedTheme = localStorage.getItem(storageKey);
        if (storedTheme === "light" || storedTheme === "dark") {
          document.documentElement.dataset.theme = storedTheme;
        }
      } catch {}
    </script>
    <slot name="head" />
  </head>
  <body>
    <SkipLink targetId={MAIN_CONTENT_ID} />
    <slot />
    {isAnalyticsEnabled && <AnalyticsScript />}
  </body>
</html>
