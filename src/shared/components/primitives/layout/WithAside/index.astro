---
interface Props {
  /** 옆 칸을 스크롤해도 화면 위에 붙여 둡니다 */
  isAsideSticky?: boolean;
}

/**
 * 본문 칸(680px) 옆에 좁은 옆 칸(220px)을 둡니다. 넓은 화면(1200px 이상)에서만 나란히 놓고,
 * 그보다 좁으면 옆 칸을 본문 아래로 내립니다. 좁은 화면에서 옆 칸을 숨길지는 `ShowOn`으로 정합니다.
 *
 * - 기본 슬롯: 본문 칸
 * - `aside` 슬롯: 옆 칸
 *
 * @design design/blog.pen 기초 보드 「04 화면 폭과 배치」 e2gfM
 */
const { isAsideSticky = false } = Astro.props;
---

<div class="container">
  <div class="main">
    <slot />
  </div>
  <div class:list={["aside", { isAsideSticky }]}>
    <slot name="aside" />
  </div>
</div>

<style>
  .container {
    display: grid;
    grid-template-columns: minmax(0, var(--content-width));
    justify-content: center;
  }

  .main {
    min-width: 0;
  }

  @media (min-width: 1200px) {
    .container {
      grid-template-columns:
        minmax(0, var(--content-width))
        var(--toc-width);
      column-gap: var(--layout-gap);
      justify-content: center;
    }

    /* 머리말이 따라오지 않으므로 화면 위에서 96px 아래에 붙입니다 (docs/design-system.md 5.2) */
    .isAsideSticky {
      position: sticky;
      top: var(--space-24);
      align-self: start;
      max-height: calc(100vh - var(--space-24) * 2);
      overflow-y: auto;
    }
  }
</style>
