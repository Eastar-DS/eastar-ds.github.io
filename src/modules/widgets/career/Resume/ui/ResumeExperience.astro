---
import type { ResumeExperience } from "@/modules/widgets/career/Resume/types/resume";
import toDisplayUrl from "@/shared/utils/toDisplayUrl";

import ResumeItemList from "./ResumeItemList.astro";

interface Props {
  experience: ResumeExperience;
}

/**
 * 이력서의 경험 하나입니다. 머리 줄(이름 h3, 한 줄 소개, 기간 같은 정보와 서비스 주소) → 맡은 일 → 줄 묶음(h4) 순서입니다.
 * 서비스 주소는 종이로 뽑아도 읽을 수 있게 주소 글자를 그대로 링크로 씁니다.
 */
const { experience } = Astro.props;
const { project, groups } = experience;
---

<article class="container">
  <header class="header">
    <h3 class="name">{project.name}</h3>
    <p class="summary">{project.summary}</p>
    <ul class="facts">
      {project.facts.map((fact) => <li>{fact}</li>)}
      {
        project.url && (
          <li>
            <a class="link" href={project.url}>
              {toDisplayUrl(project.url)}
            </a>
          </li>
        )
      }
    </ul>
  </header>
  {
    project.role && (
      <dl class="role">
        <dt class="roleLabel">맡은 일</dt>
        <dd class="roleText">{project.role}</dd>
      </dl>
    )
  }
  {
    groups.map((group) => (
      <div class="group">
        {group.title && <h4 class="groupTitle">{group.title}</h4>}
        <ResumeItemList items={group.items} />
      </div>
    ))
  }
</article>

<style>
  .container {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .header {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .name {
    font-size: var(--font-size-lead);
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-lead);
  }

  .summary {
    font-size: var(--font-size-body-sm);
    line-height: var(--line-height-body-sm);
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    color: var(--color-text-muted);
    font-size: var(--font-size-small);
    line-height: var(--line-height-small);
    list-style: none;
  }

  /* 항목 사이의 가운뎃점은 꾸밈이라 CSS로 그립니다. 줄이 바뀌어도 새 줄이 점으로 시작하지 않게 앞 항목 뒤에 붙입니다 */
  .facts > li:not(:last-child)::after {
    content: "·";
    margin-inline: var(--space-2);
  }

  .link {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-thickness: var(--border-width);
    text-underline-offset: 3px;
  }

  .link:hover {
    color: var(--color-accent-hover);
    text-decoration-thickness: var(--border-width-strong);
  }

  .role {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    font-size: var(--font-size-body-sm);
    line-height: var(--line-height-body-sm);
  }

  .roleLabel {
    color: var(--color-text-muted);
    font-size: var(--font-size-label);
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-label);
  }

  .roleText {
    margin: 0;
    text-wrap: pretty;
  }

  .group {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .groupTitle {
    color: var(--color-accent);
    font-size: var(--font-size-small);
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-small);
  }

  @media print {
    .header {
      break-after: avoid;
      break-inside: avoid;
    }

    .groupTitle {
      break-after: avoid;
    }

    .link {
      color: inherit;
      text-decoration: none;
    }
  }
</style>
