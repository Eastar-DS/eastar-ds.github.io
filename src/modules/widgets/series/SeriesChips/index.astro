---
import Chip from "@/shared/components/primitives/ui/Chip/index.astro";
import getSeriesList from "@/shared/content/getSeriesList";
import { getSeriesPath, SERIES_SECTION_ID } from "@/shared/routes/paths";

/**
 * 시리즈 목록을 칩으로 보입니다. 칩을 누르면 시리즈 페이지로 갑니다. 시리즈가 없으면 그리지 않습니다.
 * @design design/blog.pen 「칩」 prFrh, 화면 「A · 글 목록 · 넓은 화면」 Yknaw (시리즈 페이지 연결: docs/design-system.md 7.31, Pencil 시안 없음)
 */
const seriesList = await getSeriesList();
const titleId = `${SERIES_SECTION_ID}-title`;
---

{
  seriesList.length > 0 && (
    <section id={SERIES_SECTION_ID} class="container" aria-labelledby={titleId}>
      <h2 class="title" id={titleId}>
        시리즈
      </h2>
      <ul class="list">
        {seriesList.map((series) => (
          <li>
            <Chip
              href={getSeriesPath(series.id)}
              count={`${series.count}편`}
            >
              {series.name}
            </Chip>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .title {
    color: var(--color-text-muted);
    font-size: var(--font-size-label);
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-label);
  }

  .list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-3);
    list-style: none;
  }
</style>
