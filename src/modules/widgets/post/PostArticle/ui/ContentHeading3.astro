---
import AnchorHeading from "@/shared/components/primitives/ui/AnchorHeading/index.astro";

interface Props {
  id?: string;
}

/**
 * 본문의 h3입니다. MDX의 `###`를 앵커가 걸린 제목으로 바꿉니다.
 * @design design/blog.pen 「제목」 bJWiw (h3 기본 PWOAs · h3 올림 IWHBj)
 */
const { id } = Astro.props;
---

<AnchorHeading level={3} id={id}><slot /></AnchorHeading>
