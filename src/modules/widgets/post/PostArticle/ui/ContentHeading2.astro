---
import AnchorHeading from "@/shared/components/primitives/ui/AnchorHeading/index.astro";

interface Props {
  id?: string;
}

/**
 * 본문의 h2입니다. MDX의 `##`를 앵커가 걸린 제목으로 바꿉니다.
 * @design design/blog.pen 「제목」 bJWiw (h2 기본 k0eVo · h2 올림 B89Pn)
 */
const { id } = Astro.props;
---

<AnchorHeading level={2} id={id}><slot /></AnchorHeading>
