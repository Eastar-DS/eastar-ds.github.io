---
import Callout from "@/shared/components/primitives/ui/Callout/index.astro";
import getPost from "@/shared/content/getPost";
import renderPost from "@/shared/content/renderPost";
import formatDate from "@/shared/utils/formatDate";

import CodeBlock from "./ui/CodeBlock.astro";
import ContentHeading2 from "./ui/ContentHeading2.astro";
import ContentHeading3 from "./ui/ContentHeading3.astro";
import splitTitle from "./utils/splitTitle";

interface Props {
  slug: string;
}

/**
 * 글 한 편입니다. 글 정보 줄, 제목(h1), 요약, 본문을 그립니다.
 * 본문의 코드 칸 · 제목 · 「핵심」 칸은 이 컴포넌트가 정한 모양으로 바뀌므로, 글에서는 `<Callout>`을 import 없이 씁니다.
 *
 * - `after-header` 슬롯: 요약과 본문 사이에 넣을 내용. 예: 좁은 화면의 접는 목차
 */
const { slug } = Astro.props;
const post = await getPost(slug);
const { Content } = await renderPost(slug);

const publishedIso = formatDate({ date: post.publishedAt, format: "iso" });
const updatedIso = formatDate({ date: post.updatedAt, format: "iso" });
const isUpdated = publishedIso !== updatedIso;
---

<article class="container">
  <header class="header">
    <p class="meta">
      <span class="category">{post.category}</span>
      <time datetime={publishedIso}>
        {formatDate({ date: post.publishedAt, format: "long" })}
      </time>
      {
        isUpdated && (
          <span>
            <time datetime={updatedIso}>
              {formatDate({ date: post.updatedAt, format: "long" })}
            </time>{" "}
            고침
          </span>
        )
      }
      <span>{post.readingMinutes}분 읽기</span>
    </p>
    <h1 class="title">
      {
        splitTitle(post.title).map((part, index) => (
          <>
            {index > 0 && " "}
            <span class="titlePart">{part}</span>
          </>
        ))
      }
    </h1>
    <p class="summary">{post.description}</p>
  </header>
  <slot name="after-header" />
  <div class="body">
    <Content
      components={{
        pre: CodeBlock,
        h2: ContentHeading2,
        h3: ContentHeading3,
        Callout,
      }}
    />
  </div>
</article>

<style>
  .container {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .header {
    padding-bottom: 24px;
    border-bottom: 1px solid var(--color-border);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    color: var(--color-text-muted);
    font-size: var(--font-size-small);
    line-height: 1.6;
  }

  /* 항목 사이의 가운뎃점은 꾸밈이라 CSS로 그립니다 */
  .meta > * + *::before {
    content: "·";
    margin-inline: 10px;
    color: var(--color-text-muted);
  }

  .category {
    color: var(--color-accent);
    font-weight: 600;
  }

  .title {
    margin-top: 20px;
    font-size: var(--font-size-h1);
    font-weight: 700;
    line-height: 1.36;
    letter-spacing: -0.02em;
  }

  .titlePart {
    display: inline-block;
    text-wrap: balance;
  }

  .summary {
    margin-top: 20px;
    color: var(--color-text-muted);
    font-size: 18px;
    line-height: 1.65;
    text-wrap: pretty;
  }

  /*
   * 본문(MDX)의 모양. 본문 요소는 MDX가 그리므로 :global로 고릅니다.
   * 데모처럼 본문에 끼워 넣은 컴포넌트에 규칙이 새지 않게, 마크다운이 만드는 .body의 바로 아래 요소만 고릅니다.
   */
  .body > :global(* + *) {
    margin-top: 20px;
  }

  .body > :global(:is(h2, h3)) {
    text-wrap: balance;
  }

  .body > :global(h2) {
    margin-top: 56px;
    font-size: var(--font-size-h2);
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: -0.01em;
  }

  .body > :global(h3) {
    margin-top: 40px;
    font-size: var(--font-size-h3);
    font-weight: 600;
    line-height: 1.5;
  }

  .body > :global(:is(h2, h3) + *) {
    margin-top: 16px;
  }

  /* 코드 칸 · 「핵심」 칸 · 표 · 데모는 앞뒤를 조금 더 띄웁니다.
     데모를 감싼 astro-island는 display: contents라서 여백을 안쪽 요소에 줍니다 */
  .body > :global(:is(figure, [role="note"], table)),
  .body > :global(astro-island > *),
  .body
    > :global(
      :is(figure, [role="note"], table, astro-island) + :not(h2, h3)
    ) {
    margin-top: 24px;
  }

  .body > :global(:is(ul, ol)) {
    padding-left: 1.4em;
  }

  .body > :global(:is(ul, ol) li + li) {
    margin-top: 6px;
  }

  .body > :global(:is(ul, ol) li::marker) {
    color: var(--color-text-muted);
  }

  .body > :global(:is(p, ul, ol, table, blockquote) strong) {
    font-weight: 700;
  }

  .body > :global(:is(p, ul, ol, table, blockquote) a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .body > :global(:is(p, ul, ol, table, blockquote, h2, h3, [role="note"]) code) {
    padding: 2px 5px;
    border-radius: 4px;
    background: var(--color-surface);
    font-size: 0.86em;
  }

  .body > :global([role="note"] code) {
    background: var(--color-bg);
  }

  .body > :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 15px;
    line-height: 1.6;
  }

  .body > :global(table :is(th, td)) {
    padding: 10px 12px;
    border-bottom: 1px solid var(--color-border);
    text-align: left;
    vertical-align: top;
  }

  .body > :global(table th) {
    color: var(--color-text-muted);
    font-weight: 600;
    white-space: nowrap;
  }

  .body > :global(blockquote) {
    padding-left: 16px;
    border-left: 3px solid var(--color-border);
    color: var(--color-text-muted);
  }

  .body > :global(hr) {
    margin-block: 40px;
    border: 0;
    border-top: 1px solid var(--color-border);
  }

  @media (max-width: 640px) {
    /* 좁은 화면에서 표가 넘치면 표만 옆으로 밀어 봅니다 */
    .body > :global(table) {
      display: block;
      overflow-x: auto;
    }

    .title {
      margin-top: 16px;
      line-height: 1.4;
    }

    .summary {
      margin-top: 16px;
      font-size: 16px;
    }

    .body > :global(h2) {
      margin-top: 44px;
    }
  }
</style>
