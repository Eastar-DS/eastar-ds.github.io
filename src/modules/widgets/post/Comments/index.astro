---
import { IS_COMMENTS_ENABLED } from "@/shared/constants/features";
import { TURNSTILE_SITE_KEY, WORKER_URL } from "@/shared/constants/services";
import { getPostPath } from "@/shared/routes/paths";
import isCommentsReady from "@/shared/utils/isCommentsReady";

import CommentSection from "./ui/CommentSection.astro";

interface Props {
  /** 댓글을 보일 글의 slug */
  slug: string;
}

/**
 * 글 맨 끝의 댓글 칸입니다. 로그인 없는 익명 댓글을 Cloudflare Worker를 거쳐 노션 DB에 저장합니다(docs/plan.md 「댓글」).
 * `IS_COMMENTS_ENABLED`(shared/constants/features)가 켜져 있고 `WORKER_URL` · `TURNSTILE_SITE_KEY`(shared/constants/services)가
 * 모두 있을 때만 그립니다. 값이 비어 있으면 astro.config.ts가 CommentSection을 빈 부품으로 바꿔, 댓글의 CSS와 스크립트가
 * 빌드 결과에 아예 실리지 않습니다.
 * @design design/blog.pen 「댓글 자리」 GbsK7
 */
const { slug } = Astro.props;
const isReady = isCommentsReady({
  isEnabled: IS_COMMENTS_ENABLED,
  workerUrl: WORKER_URL,
  turnstileSiteKey: TURNSTILE_SITE_KEY,
});
---

{
  isReady && (
    <CommentSection
      postPath={getPostPath(slug)}
      workerUrl={WORKER_URL}
      turnstileSiteKey={TURNSTILE_SITE_KEY}
    />
  )
}
