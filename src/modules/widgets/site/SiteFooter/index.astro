---
import Container from "@/shared/components/primitives/layout/Container/index.astro";
import { SITE } from "@/shared/constants/site";
import { PATHS } from "@/shared/routes/paths";
import formatDate from "@/shared/utils/formatDate";

/**
 * 사이트 꼬리말입니다. 저작권 줄과 RSS · GitHub · 개인정보 처리 안내 링크를 둡니다. 좁은 칸에서는 두 줄로 쌓고, 인쇄할 때는 그리지 않습니다.
 * @design design/blog.pen 「꼬리말」 m9iWo (넓은 화면 qgxES · 휴대폰 oHQDs)
 */
const year = formatDate({ date: new Date(), format: "year" });
const links = [
  { label: "RSS", href: PATHS.rss },
  { label: "GitHub", href: SITE.author.githubUrl },
  { label: "개인정보 처리 안내", href: PATHS.privacy },
];
---

<footer class="root">
  <Container size="page">
    <div class="bar">
      <p class="copyright">© {year} {SITE.author.name}</p>
      <ul class="links">
        {
          links.map((link) => (
            <li>
              <a class="link" href={link.href}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </Container>
</footer>

<style>
  .root {
    border-top: var(--border-width) solid var(--color-border);
    container-type: inline-size;
  }

  .bar {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-block: var(--space-6);
    color: var(--color-text-muted);
    font-size: var(--font-size-small);
    line-height: var(--line-height-small);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    list-style: none;
  }

  .link {
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .link:hover {
    color: var(--color-text);
  }

  @media print {
    .root {
      display: none;
    }
  }

  @container (min-width: 768px) {
    .bar {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
</style>
