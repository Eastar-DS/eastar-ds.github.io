---
import ThemeToggle from "@/modules/features/site/ThemeToggle/index.astro";
import Container from "@/shared/components/primitives/layout/Container/index.astro";
import Icon from "@/shared/components/primitives/ui/Icon/index.astro";
import IconButton from "@/shared/components/primitives/ui/IconButton/index.astro";
import { SITE } from "@/shared/constants/site";
import { NAV_ITEMS, PATHS } from "@/shared/routes/paths";

import isCurrentPath from "./utils/isCurrentPath";

/**
 * 사이트 머리말입니다. 사이트 이름, 주 메뉴, RSS, 밝기 단추를 둡니다. 화면에 붙어 따라오지 않습니다.
 * 머리말 칸이 767px 이하면 주 메뉴를 메뉴 단추 안으로 접습니다. 메뉴는 JavaScript 없이 열리고, Esc로 닫으면 메뉴 단추로 포커스가 돌아갑니다.
 * @design design/blog.pen 「머리말」 mg60A (넓은 화면 r6OXd · 휴대폰 W5ZR4d)
 */
const { pathname } = Astro.url;
const navItems = NAV_ITEMS.map((item) => ({
  ...item,
  isCurrent: isCurrentPath({ pathname, href: item.href }),
}));
---

<header class="root">
  <Container size="page">
    <div class="bar">
      <a class="logo" href={PATHS.home}>{SITE.title}</a>
      <div class="actions">
        <nav class="wideNav" aria-label="주 메뉴">
          <ul class="navList">
            {
              navItems.map((item) => (
                <li>
                  <a
                    class="navLink"
                    href={item.href}
                    aria-current={item.isCurrent ? "page" : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <IconButton as="a" href={PATHS.rss} label="RSS 구독" class="wideOnly">
          <Icon name="rss" />
        </IconButton>
        <ThemeToggle />
        <details class="narrowMenu" data-site-menu>
          <IconButton as="summary" label="메뉴">
            <Icon name="menu" class="menuIcon" />
            <Icon name="x" class="closeIcon" />
          </IconButton>
          <nav class="menuPanel" aria-label="주 메뉴">
            <ul class="menuList">
              {
                navItems.map((item) => (
                  <li>
                    <a
                      class="menuLink"
                      href={item.href}
                      aria-current={item.isCurrent ? "page" : undefined}
                    >
                      {item.label}
                    </a>
                  </li>
                ))
              }
              <li>
                <a class="menuLink" href={PATHS.rss}>RSS 구독</a>
              </li>
            </ul>
          </nav>
        </details>
      </div>
    </div>
  </Container>
</header>

<script>
  const menus = document.querySelectorAll<HTMLDetailsElement>(
    "[data-site-menu]",
  );

  menus.forEach((menu) => {
    const handleKeydown = (event: KeyboardEvent) => {
      if (event.key !== "Escape" || !menu.open) return;

      menu.open = false;
      menu.querySelector("summary")?.focus();
    };

    // 같은 페이지 안의 자리(/#series)로 가는 링크를 눌러도 메뉴가 열린 채 본문을 가리지 않게 닫습니다
    const handleLinkClick = () => {
      menu.open = false;
    };

    menu.addEventListener("keydown", handleKeydown);
    menu
      .querySelectorAll("a")
      .forEach((link) => link.addEventListener("click", handleLinkClick));
  });
</script>

<style>
  .root {
    position: relative;
    border-bottom: var(--border-width) solid var(--color-border);
    container-type: inline-size;
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    height: var(--header-height);
  }

  .logo {
    color: var(--color-text);
    font-size: var(--font-size-lead);
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-lead);
    white-space: nowrap;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  .navList {
    display: flex;
    gap: var(--space-1);
    margin-right: var(--space-2);
    list-style: none;
  }

  .navLink {
    display: block;
    padding: var(--space-1) var(--space-3);
    color: var(--color-text-muted);
    font-size: var(--font-size-body-sm);
    line-height: var(--line-height-body-sm);
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .navLink:hover,
  .navLink[aria-current="page"] {
    color: var(--color-text);
  }

  .navLink[aria-current="page"] {
    font-weight: var(--font-weight-semibold);
  }

  .narrowMenu :global(.closeIcon),
  .narrowMenu[open] :global(.menuIcon) {
    display: none;
  }

  .narrowMenu[open] :global(.closeIcon) {
    display: block;
  }

  .menuPanel {
    position: absolute;
    top: 100%;
    right: 0;
    left: 0;
    z-index: 10;
    padding: var(--space-2) var(--page-padding-inline) var(--space-4);
    border-bottom: var(--border-width) solid var(--color-border);
    background: var(--color-bg);
  }

  .menuList {
    list-style: none;
  }

  .menuLink {
    display: block;
    padding: var(--space-2) 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-body);
  }

  .menuLink[aria-current="page"] {
    color: var(--color-text);
    font-weight: var(--font-weight-semibold);
  }

  /* 휴대폰(767px 이하)에서는 메뉴를 접고, 768px부터 펼칩니다 */
  .wideNav,
  .root :global(.wideOnly) {
    display: none;
  }

  @container (min-width: 768px) {
    .wideNav {
      display: block;
    }

    .root :global(.wideOnly) {
      display: inline-flex;
    }

    .narrowMenu {
      display: none;
    }
  }
</style>
