---
/**
 * 폴더 카드 하나에서 DOM에 그리는 행(보이는 행 · 미리 그린 행)과, 행 없이 높이만 비워 두는 부분을 위에서 아래로 보여 주는 그림입니다.
 * JavaScript 없이 서버에서 그리고, 색은 토큰만 써서 어두운 화면에서도 그대로 보입니다. 글에서는 `<Figure>`로 감싸 설명을 붙입니다.
 * 숫자는 Knot PR #1142 본문의 그림(문서 1,000개 폴더를 높이 600px인 main 안에서 30,000px 스크롤했을 때)과 같은 상황입니다.
 * 행 번호는 코드의 배열 순서처럼 0부터 셉니다. 세로 길이는 비율대로 그리지 않습니다.
 * 「보이는 행」은 데모와 같은 강조색(●), 「미리 그린 행」은 데이터 색 1(▲), 빈 높이는 옅은 선 색(□)입니다.
 */
const bands = [
  {
    kind: "gap",
    title: "위쪽 그리지 않은 행의 자리",
    detail: "0–455번 행은 li가 없습니다. 카드의 위쪽 여백(paddingTop 29,639px)이 그 높이를 채웁니다.",
    rowCount: 0,
  },
  {
    kind: "overscan",
    title: "▲ overscan 안의 행 5개 (456–460번)",
    detail: "화면 위로 넓힌 325px 안에 걸친 행이라 미리 그립니다.",
    rowCount: 5,
  },
  {
    kind: "visible",
    title: "● 보이는 행 10개 (461–470번)",
    detail: "main에 보이는 600px입니다.",
    rowCount: 10,
  },
  {
    kind: "overscan",
    title: "▲ overscan 안의 행 5개 (471–475번)",
    detail: "화면 아래로 넓힌 325px 안에 걸친 행입니다.",
    rowCount: 5,
  },
  {
    kind: "gap",
    title: "아래쪽 그리지 않은 행의 자리",
    detail: "476–999번 행도 li가 없습니다. 카드 높이(64,999px)를 행을 모두 그린 높이로 두어서 스크롤바 길이가 바뀌지 않습니다.",
    rowCount: 0,
  },
] as const;
---

<div class="container">
  <p class="edge">카드 맨 위 (0px)</p>
  <ol class="bands">
    {
      bands.map((band) => (
        <li class:list={["band", band.kind]}>
          <span class="bar" aria-hidden="true">
            {Array.from({ length: band.rowCount }, () => (
              <span class="row" />
            ))}
          </span>
          <span class="text">
            <span class="title">{band.title}</span>
            <span class="detail">{band.detail}</span>
          </span>
        </li>
      ))
    }
  </ol>
  <p class="edge">카드 맨 아래 (64,999px, 문서 1,000개를 모두 그린 높이)</p>
</div>

<style>
  .container {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    container: window-diagram / inline-size;
  }

  .edge {
    color: var(--color-text-muted);
    font-size: var(--font-size-caption);
    line-height: var(--line-height-caption);
  }

  .bands {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* 카드 모형(왼쪽 막대)과 설명(오른쪽 글)을 나란히 둡니다 */
  .band {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
    gap: var(--space-4);
  }

  .bar {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-1);
    padding: var(--space-2);
    border-inline: var(--border-width-strong) solid var(--color-border-strong);
    background: var(--color-bg);
  }

  .band:first-child .bar {
    border-top: var(--border-width-strong) solid var(--color-border-strong);
    border-radius: var(--radius-md) var(--radius-md) 0 0;
  }

  .band:last-child .bar {
    border-bottom: var(--border-width-strong) solid var(--color-border-strong);
    border-radius: 0 0 var(--radius-md) var(--radius-md);
  }

  /* 행 하나. 행 사이는 선 없이 4px 틈(.bar의 gap)으로 나눕니다 */
  .row {
    display: block;
    height: var(--space-2);
    border-radius: var(--radius-sm);
  }

  .overscan .row {
    background: var(--color-data-1);
  }

  .visible .row {
    background: var(--color-accent);
  }

  /* 화면에 해당하는 구간은 테두리로 감쌉니다 */
  .visible .bar {
    outline: var(--border-width-strong) solid var(--color-text);
    outline-offset: calc(var(--border-width-strong) * -1);
  }

  /* 그리지 않은 행의 자리: 행이 없다는 것을 옅은 바탕으로만 보입니다 */
  .gap .bar {
    min-height: var(--space-14);
    background: var(--color-border);
  }

  .text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-1);
    padding-block: var(--space-2);
  }

  .title {
    color: var(--color-text);
    font-size: var(--font-size-body-sm);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-body-sm);
  }

  .detail {
    color: var(--color-text-muted);
    font-size: var(--font-size-caption);
    line-height: var(--line-height-caption);
    text-wrap: pretty;
  }

  @container window-diagram (min-width: 520px) {
    .band {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      gap: var(--space-6);
    }
  }

  @media (forced-colors: active) {
    .overscan .row,
    .visible .row {
      background: CanvasText;
    }

    .gap .bar {
      background: GrayText;
    }
  }
</style>
