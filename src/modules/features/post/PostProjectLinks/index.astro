---
import { CAREER_PROJECTS } from "@/shared/constants/career";
import { IS_PORTFOLIO_SHOWN } from "@/shared/constants/features";
import getPost from "@/shared/content/getPost";
import { getPortfolioProjectPath } from "@/shared/routes/paths";

interface Props {
  slug: string;
}

/**
 * 글 끝에서 이 글과 이어진 프로젝트를 「이 글과 이어진 프로젝트: Knot」처럼 보이고, 포트폴리오의 그 프로젝트 구획으로 잇습니다.
 * 프로젝트는 글 앞머리의 `projects` 칸에 적고, 나열 순서는 포트폴리오와 같은 Knot → 셀러홈 → 비드입니다.
 * 적지 않았거나 포트폴리오 페이지가 없으면(`IS_PORTFOLIO_SHOWN`) 아무것도 그리지 않습니다.
 * 디자인은 docs/design-system.md 7.26에 있고, Pencil 시안은 없습니다.
 */
const { slug } = Astro.props;
const post = await getPost(slug);
const projects = IS_PORTFOLIO_SHOWN
  ? Object.values(CAREER_PROJECTS).filter((project) =>
      post.projects?.includes(project.id),
    )
  : [];
---

{
  projects.length > 0 && (
    <p class="container">
      <span class="label">이 글과 이어진 프로젝트</span>{" "}
      {projects.map((project, index) => (
        <>
          {index > 0 && ", "}
          <a class="link" href={getPortfolioProjectPath(project.id)}>
            {project.name}
          </a>
        </>
      ))}
    </p>
  )
}

<style>
  .container {
    padding-top: var(--space-4);
    border-top: var(--border-width) solid var(--color-border);
    font-size: var(--font-size-body-sm);
    line-height: var(--line-height-body-sm);
  }

  /* 이름표와 링크 사이에는 글자 공백을 두어 복사하거나 읽어 줄 때 낱말이 붙지 않게 하고, 모자란 간격만 여백으로 채웁니다 */
  .label {
    margin-right: var(--space-1);
    color: var(--color-text-muted);
  }

  .link {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-thickness: var(--border-width);
    text-underline-offset: 3px;
  }

  .link:hover {
    color: var(--color-accent-hover);
    text-decoration-thickness: var(--border-width-strong);
  }
</style>
