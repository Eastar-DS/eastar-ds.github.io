---
import { SITE } from "@/shared/constants/site";
import getPostsBySlugs from "@/shared/content/getPostsBySlugs";
import { getPostPath } from "@/shared/routes/paths";
import toDisplayUrl from "@/shared/utils/toDisplayUrl";

interface Props {
  /** 이어 줄 글 이름(slug). 없는 글 이름이 있으면 빌드가 멈춥니다 */
  slugs: readonly string[];
}

/**
 * 이력서 줄과 포트폴리오 사례 끝에 「관련 글」 링크를 줄마다 하나씩 그립니다. 글 제목은 글 모음에서 읽습니다.
 * 글자 크기는 놓이는 곳의 크기를 따르고, 바깥 여백과 구분선은 놓는 쪽이 정합니다.
 * 종이로 뽑으면 링크를 누를 수 없으므로, 인쇄할 때는 제목 뒤에 글 주소를 괄호로 붙입니다.
 * 디자인은 docs/design-system.md 7.25에 있고, Pencil 시안은 없습니다.
 */
const { slugs } = Astro.props;
const posts = await getPostsBySlugs(slugs);
const links = posts.map((post) => {
  const path = getPostPath(post.slug);

  return {
    title: post.title,
    href: path,
    printUrl: toDisplayUrl(new URL(path, SITE.url).href),
  };
});
---

{
  links.length > 0 && (
    <ul class="container">
      {links.map((link) => (
        <li>
          <span class="label">관련 글</span>{" "}
          <a class="link" href={link.href}>
            {link.title}
          </a>
          <span class="printUrl"> ({link.printUrl})</span>
        </li>
      ))}
    </ul>
  )
}

<style>
  .container {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    list-style: none;
  }

  /* 이름표와 링크 사이에는 글자 공백을 두어 복사하거나 읽어 줄 때 낱말이 붙지 않게 하고, 모자란 간격만 여백으로 채웁니다 */
  .label {
    margin-right: var(--space-1);
    color: var(--color-text-muted);
  }

  .link {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-thickness: var(--border-width);
    text-underline-offset: 3px;
  }

  .link:hover {
    color: var(--color-accent-hover);
    text-decoration-thickness: var(--border-width-strong);
  }

  .printUrl {
    display: none;
  }

  /* 종이에서는 링크를 누를 수 없어서, 밑줄과 강조색을 빼고 글 주소를 제목 뒤에 붙입니다 (docs/design-system.md 7.23 인쇄) */
  @media print {
    .link {
      color: inherit;
      text-decoration: none;
    }

    .printUrl {
      display: inline;
      overflow-wrap: anywhere;
    }
  }
</style>
