---
import getSeries from "@/shared/content/getSeries";
import { getPostPath } from "@/shared/routes/paths";

interface Props {
  id: string;
  currentSlug?: string;
}

/**
 * 시리즈 편 목록이며 지금 편과 준비 중인 편을 글로 표시합니다.
 * @design docs/design-system.md 7.30, 7.31 (Pencil 시안 없음)
 */
const { id, currentSlug } = Astro.props;
const series = await getSeries(id);
---

<ol class="list">
  {series.parts.map((part) => (
    <li class="item" value={part.order}>
      {part.slug ? (
        <a href={getPostPath(part.slug)} aria-current={part.slug === currentSlug ? "page" : undefined}>{part.title}</a>
      ) : <span>{part.title}</span>}
      {part.slug !== undefined && part.slug === currentSlug && <span class="status">지금 편</span>}
      {!part.slug && <span class="status">준비 중</span>}
    </li>
  ))}
</ol>

<style>
  .list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-left: var(--space-5);
    font-size: var(--font-size-body-sm);
    line-height: var(--line-height-body-sm);
  }
  .item {
    padding-left: var(--space-1);
  }
  .item::marker {
    color: var(--color-text-muted);
  }
  .item a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .item a:hover {
    color: var(--color-accent-hover);
  }
  .item [aria-current="page"] {
    font-weight: var(--font-weight-semibold);
  }
  .status {
    display: inline-block;
    margin-left: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--font-size-small);
  }
</style>
