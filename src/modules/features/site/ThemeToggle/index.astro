---
import Icon from "@/shared/components/primitives/ui/Icon/index.astro";
import IconButton from "@/shared/components/primitives/ui/IconButton/index.astro";

/**
 * 밝은 화면과 어두운 화면을 바꾸는 단추입니다. 고른 테마는 localStorage에 남고,
 * 첫 그림 전 적용은 Document의 인라인 스크립트가 맡습니다.
 * 고르기 전에는 시스템 설정을 따르며, 아이콘과 이름은 누르면 바뀔 화면을 알립니다(밝을 때 달 · 「어두운 화면으로」).
 * JavaScript가 꺼져 있으면 누를 수 없으므로 숨깁니다.
 * @design design/blog.pen 「머리말」 mg60A 밝기 단추, 「아이콘 단추」 Bh8HQ
 */
---

<IconButton label="어두운 화면으로" class="themeToggle" data-theme-toggle>
  <Icon name="moon" class="moon" />
  <Icon name="sun" class="sun" />
</IconButton>

<script>
  import { THEME_STORAGE_KEY } from "@/shared/constants/theme";

  import getNextTheme from "./utils/getNextTheme";
  import getThemeToggleLabel from "./utils/getThemeToggleLabel";
  import resolveTheme from "./utils/resolveTheme";

  const darkQuery = window.matchMedia("(prefers-color-scheme: dark)");
  const buttons = document.querySelectorAll<HTMLButtonElement>(
    "[data-theme-toggle]",
  );

  const getCurrentTheme = () =>
    resolveTheme({
      chosenTheme: document.documentElement.dataset.theme,
      isSystemDark: darkQuery.matches,
    });

  const syncLabel = () => {
    const label = getThemeToggleLabel(getCurrentTheme());

    buttons.forEach((button) => button.setAttribute("aria-label", label));
  };

  const handleClick = () => {
    const nextTheme = getNextTheme(getCurrentTheme());

    document.documentElement.dataset.theme = nextTheme;
    try {
      localStorage.setItem(THEME_STORAGE_KEY, nextTheme);
    } catch {
      // 저장소를 못 쓰는 환경(사생활 보호 모드 등)에서는 이번 방문 동안만 바뀝니다
    }
    syncLabel();
  };

  buttons.forEach((button) => button.addEventListener("click", handleClick));
  darkQuery.addEventListener("change", syncLabel);
  syncLabel();
</script>

<style>
  /* 단추와 아이콘은 IconButton · Icon이 그려서 이 컴포넌트의 범위 속성이 없으므로 :global로 고릅니다 */
  :global(.no-js .themeToggle) {
    display: none;
  }

  :global(.themeToggle .sun) {
    display: none;
  }

  :global(:root[data-theme="dark"] .themeToggle .sun) {
    display: block;
  }

  :global(:root[data-theme="dark"] .themeToggle .moon) {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"]) .themeToggle .sun) {
      display: block;
    }

    :global(:root:not([data-theme="light"]) .themeToggle .moon) {
      display: none;
    }
  }
</style>
