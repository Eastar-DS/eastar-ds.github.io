---
import Portfolio from "@/modules/widgets/career/Portfolio/index.astro";
import SiteFooter from "@/modules/widgets/site/SiteFooter/index.astro";
import SiteHeader from "@/modules/widgets/site/SiteHeader/index.astro";
import Container from "@/shared/components/primitives/layout/Container/index.astro";
import Document from "@/shared/components/primitives/layout/Document/index.astro";
import { IS_RESUME_SHOWN } from "@/shared/constants/features";
import getSwitchPagePaths from "@/shared/routes/getSwitchPagePaths";
import { MAIN_CONTENT_ID, PATHS } from "@/shared/routes/paths";
import createPageMeta from "@/shared/seo/createPageMeta";

/**
 * 포트폴리오 페이지(/portfolio/). 이력서와 같은 공개 스위치(`IS_RESUME_PUBLIC`)를 따르며, 켜졌거나 개발 서버일 때만 만듭니다.
 * 고정 주소 페이지는 getStaticPaths를 쓸 수 없어서 `[...path]` 폴더에 두고, path가 빈 주소 하나만 만듭니다.
 */
export const getStaticPaths = () => getSwitchPagePaths(IS_RESUME_SHOWN);

const meta = createPageMeta({
  title: "포트폴리오",
  description:
    "이스타가 Knot, 셀러홈, 비드에서 찾은 문제와 세운 가설, 한 일과 결과를 프로젝트마다 차례대로 적었습니다.",
  path: PATHS.portfolio,
});
---

<Document meta={meta}>
  <SiteHeader />
  <main id={MAIN_CONTENT_ID} tabindex="-1" class="main">
    <Container size="content">
      <Portfolio />
    </Container>
  </main>
  <SiteFooter />
</Document>

<style>
  .main {
    padding-block: var(--space-10) var(--space-12);
  }

  @media (min-width: 768px) {
    .main {
      padding-block: var(--space-18) var(--space-24);
    }
  }

  @media print {
    .main {
      padding-block: 0;
    }
  }
</style>
