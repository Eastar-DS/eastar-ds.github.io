{
  "name": "eastar-ds-blog",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/buildFonts.ts && astro build && node scripts/buildFonts.ts --check",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:worker": "pnpm --dir worker test",
    "check:worker": "pnpm --dir worker typecheck",
    "test:all": "pnpm check && pnpm test && pnpm check:worker && pnpm test:worker",
    "fonts": "node scripts/buildFonts.ts",
    "fonts:check": "node scripts/buildFonts.ts --check",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.6",
    "@astrojs/react": "^7.1.9",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.6",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "astro": "^7.4.13",
    "pretendard": "^1.3.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@kfonts/d2coding": "0.2.0",
    "@shikijs/themes": "4.6.0",
    "@shikijs/transformers": "4.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/subset-font": "2.3.0",
    "fonteditor-core": "^2.6.3",
    "satori": "0.63.2",
    "sharp": "^0.35.5",
    "subset-font": "2.9.0",
    "typescript": "^6.0.3",
    "ultrahtml": "1.7.0",
    "vitest": "^5.1.1"
  }
}
